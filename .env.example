# === AST PoC Configuration ===

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=nomic-embed-text

# External LLM (used when security mode is OFF)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=o3

# ChromaDB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION_NAME=ast_documents

# Data paths
DATA_INPUT_PST_DIR=./data/input/pst
DATA_INPUT_DOCS_DIR=./data/input/documents
DATA_PROCESSED_DIR=./data/processed

# Chunking
CHUNK_SIZE_DOCS=1000
CHUNK_OVERLAP_DOCS=200
CHAT_WINDOW_MINUTES=30

# API
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECURITY_MODE=on

# Case Management
CASES_DIR=./data/cases
MAX_CONCURRENT_INDEXING=1

# BM25
BM25_INDEX_DIR=./data/bm25_index
