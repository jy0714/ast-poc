# === AST PoC — 개발 환경 (RTX 2060 12GB, 구 개발 PC) ===
# cp .env.dev.example .env

# Ollama (Docker: http://ollama:11434, 로컬: http://localhost:11434)
# Ollama 서버 쪽 환경 변수(여기가 아니라 Ollama 프로세스·docker-compose ollama 서비스에 설정):
#   OLLAMA_KEEP_ALIVE=-1          실험 중 모델이 내려가지 않게
#   OLLAMA_MAX_LOADED_MODELS=2    임베딩 + LLM 동시 적재
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b-q8_0

# External LLM (security_mode=off 일 때만 사용)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=o3

# Data paths
DATA_INPUT_PST_DIR=./data/input/pst
DATA_INPUT_DOCS_DIR=./data/input/documents
DATA_PROCESSED_DIR=./data/processed

# Units (v4 증거 단위)
UNIT_MAX_PART_TOKENS=2048
CHAT_SESSION_GAP_MINUTES=30
EMAIL_CLEAN_ENABLED=true

# Index (v4 케이스 폴더 색인)
INDEX_DIR=./data/index
SERVICE_INDEX_PROFILE=hdr-qwen3

# Embedding — v4: Qwen3-Embedding-4B 8비트 (2,560차원). 질의에만 영어 지시문(EMBED_QUERY_TASK).
# 큰 배치는 Ollama 타임아웃을 유발해 인덱싱이 멈출 수 있어 보수적으로 시작 (RTX 2060 12GB).
# 안정 동작 확인 후 16, 32로 단계적 상향 권장.
EMBED_BATCH_SIZE=8
EMBED_DIM=2560
EMBED_NUM_CTX=8192
EMBED_QUERY_TASK="Given an internal audit investigation query, retrieve emails, chat messages, and documents in any language that contain evidence relevant to the query"

# Indexing Performance — 2060 12GB 기준
INDEXING_WORKERS=0
MAX_INDEXING_WORKERS=16
INDEXING_STORE_BATCH_SIZE=64

# Search — v4 retrieve(): 검색기별 상위 단위 수 → RRF(k=60, 하한·가중치 없음)
SEARCH_K_BM25=50
SEARCH_K_DENSE=50
RRF_K=60

# Reranker — v4: qwen3(서비스 기본) | bge(R9 비교 실험 전용)
RERANK_ENABLED=true
RERANK_BACKEND=qwen3
# 개발 PC(RTX 2060, Turing)는 BF16 미지원 → 0.6B + fp16으로 동작만 확인
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_DTYPE=fp16
RERANK_BGE_MODEL=BAAI/bge-reranker-v2-m3
# 템플릿·질의·문서 합계 토큰 상한 — qwen3·bge 공통 (R9 공정성)
RERANK_MAX_LENGTH=4096
RERANK_BATCH_SIZE=4
RERANK_CANDIDATES=30
RERANK_TOP_N=5
# Qwen3 P(yes) 척도에서 다시 정하기 전까지 끔
RERANK_MIN_SCORE=0.0
RERANK_INSTRUCTION="Judge whether this email, chat session, or document page contains evidence relevant to the internal audit investigation query. The document may be in any language."

# API
API_HOST=0.0.0.0
API_PORT=8000

# Security (on=로컬 전용, off=외부 API 허용)
SECURITY_MODE=on

