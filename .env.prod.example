# === AST PoC — 운영 환경 (A5000 24GB) ===
# cp .env.prod.example .env

# Ollama (Docker: http://ollama:11434, 로컬: http://localhost:11434)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=bge-m3

# External LLM (security_mode=off 일 때만 사용)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=o3

# ChromaDB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION_NAME=ast_documents

# Data paths
DATA_INPUT_PST_DIR=./data/input/pst
DATA_INPUT_DOCS_DIR=./data/input/documents
DATA_PROCESSED_DIR=./data/processed

# Chunking
CHUNK_SIZE_DOCS=1000
CHUNK_OVERLAP_DOCS=200
CHAT_WINDOW_MINUTES=30
EMAIL_THREAD_MAX_CHARS=2000

# BM25
BM25_INDEX_DIR=./data/bm25_index

# Embedding — A5000 24GB VRAM 기준 (bge-m3 4096 토큰 컨텍스트 고려)
# 3060 기준 8을 안전 시작점으로 잡고 운영 환경에서는 2배에서 출발해 단계 상향.
# 대용량 배치는 Ollama 타임아웃 캐스케이드를 유발하므로 모니터링하며 튜닝.
EMBED_BATCH_SIZE=16

# Indexing Performance — A5000 24GB 기준
INDEXING_WORKERS=0
MAX_INDEXING_WORKERS=16
INDEXING_STORE_BATCH_SIZE=128

# Search
SEARCH_TOP_K=20
RRF_K=60
RRF_MIN_SCORE=0.0141

# Reranker — 운영 환경에서는 ON 권장
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K_CANDIDATES=50
RERANK_TOP_N=5

# API
API_HOST=0.0.0.0
API_PORT=8000

# Security (on=로컬 전용, off=외부 API 허용)
SECURITY_MODE=on

